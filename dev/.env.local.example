# Feishu (Lark) OAuth credentials — per-deployment secrets.
#
# 🔴 COPY THIS TO `dev/.env.local` AND FILL IT IN. Do NOT put these values in
# `dev/.env`: that file is TRACKED BY GIT (it carries the local stack's
# connection strings, which upstream ships on purpose), so a secret written
# there gets committed. `*.env.local` is gitignored.
#
# Start the stack with BOTH files, `.env.local` last so it wins:
#
#   cd dev
#   docker compose --env-file .env --env-file .env.local \
#     -f docker-compose.yaml -f docker-compose.min.yaml up -d
#
# ⚠️ `rush docker:up` / `docker:up:min` do NOT pass `--env-file`, so use the
# explicit command above when you need these values.

# ── Required. Without all three the provider does not register at all and the
#    login page shows NO button (an absent button is the symptom of a missing
#    secret — it is not an error). From https://open.feishu.cn → 企业自建应用.
FEISHU_CLIENT_ID=
FEISHU_CLIENT_SECRET=
# Comma separated. ⚠️ `tenant_key` is NOT shown on the app config page — it is
# only known after a login. Put a deliberately wrong value here first, log in
# once, and read the real one out of the account log: the rejection line prints
# `tenantKey` on purpose (`reason: 'tenant not allowed'`).
FEISHU_ALLOWED_TENANT_KEYS=

# ── Optional.
# Login button label. Unset renders "Feishu" (the component default).
FEISHU_DISPLAY_NAME=飞书
# Derived from ACCOUNTS_URL + /auth/feishu/callback when unset. Must match the
# redirect URI registered on the Feishu app EXACTLY, character for character.
# FEISHU_REDIRECT_URL=http://agentra.local:3000/auth/feishu/callback

# ── Workspace assignment (technical-spec D3).
# Syntax: tenantKey:workspaceSlug[:ROLE] , comma separated. ROLE defaults to USER.
# ⚠️ workspaceSlug is the workspace `url` column, NOT an http URL.
# ⚠️ ADMIN is refused here on purpose — an env typo must not hand a whole tenant
#    platform-level privilege.
# ⚠️ A malformed value REFUSES to register the provider rather than degrading to
#    "no mapping", so one typo cannot become "everyone authenticates, nobody can
#    get in" discovered only in production.
# ⚠️ Unset = workspace assignment is OFF; login still succeeds with no workspace.
# FEISHU_TENANT_WORKSPACE_MAP=<tenant_key>:agentra-main:USER

# ── Strict booleans: only "true"/"false". BOTH DEFAULT TO FALSE — granting
#    workspace membership and rewriting someone's profile are privileged, so they
#    are opt-in. Any other value refuses registration.
# FEISHU_AUTO_PROVISION=true
# FEISHU_SYNC_PROFILE=true

# ── Optional dedicated key for signing the OAuth state. Falls back to
#    SERVER_SECRET when unset.
# FEISHU_STATE_HMAC_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# GitHub 集成
#
# 🔴 需要一个 GITHUB APP（不是 Personal Access Token）。见
#    docs/engineering/github-integration.md 的建 App 步骤。
# 🔴 缺任一必填项，pod-github 会直接退出并打印缺了哪个，不会降级运行。

# App 设置页顶部的 App ID（纯数字）
APP_ID=
# 同一页的 Client ID（Iv1. 或 Iv23 开头）
CLIENT_ID=
# 同一页 "Generate a new client secret" 生成
CLIENT_SECRET=
# ⚠️ 私钥必须写成单行，换行转义成字面量 \n。config.ts 会做
#    `.replace(/\\n/g, '\n')` 还原。直接贴多行 PEM 会解析失败。
#    转换：awk 'BEGIN{ORS="\\n"}1' your-key.pem
PRIVATE_KEY=
# App 设置页 Webhook 区自填的字符串，要与 GitHub 那边填的一致
WEBHOOK_SECRET=
# App 的 slug（安装页 URL 里 /apps/<这一段>）
BOT_NAME=

# 可用工作区白名单，逗号分隔；* 为全部
ALLOWED_WORKSPACES=*

# 前端用（front 从环境变量生成 config.json）
# GITHUB_APP 是 App 的 slug，与 BOT_NAME 通常相同；GITHUB_CLIENTID 与 CLIENT_ID 相同
GITHUB_APP=
GITHUB_CLIENTID=
