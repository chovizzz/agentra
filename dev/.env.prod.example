# Agentra 生产部署环境变量（Dokploy / 单机）
# 复制成 .env.prod 填写。⚠️ 不要提交填好的那份。

# 对外访问的域名后缀。所有服务都以 <服务>.${SERVER_HOST} 的形式经
# Traefik 暴露在 80 端口（云安全组只放行 22/80/443/3000）。
#
# 没有自己的域名时用 sslip.io 的通配 DNS：<IP>.sslip.io 及其任意子域
# 都解析到该 IP，所以 front.49.51.37.69.sslip.io 直接可用，无需注册。
# ⚠️ 不要填裸 IP —— 那样会生成 front.49.51.37.69 这种解析不了的名字。
#
# 买了域名后换成域名即可，compose 不用动；飞书与 GitHub 的回调地址
# 要同步改。
SERVER_HOST=49.51.37.69.sslip.io

# 镜像版本。与 git commit 对应，可追溯到具体代码。
AGENTRA_TAG=6e3227395

# 🔴 必改。用 openssl rand -hex 32 生成，不要沿用 dev 栈的 "secret"。
SERVER_SECRET=

# 数据库（容器内地址，不对外）
DB_URL=postgresql://root@cockroach:26257/defaultdb?sslmode=disable

# 对象存储（容器内地址）
MINIO_USER=minioadmin
MINIO_PASSWORD=
STORAGE_CONFIG=datalake|http://datalake:4030
# ⚠️ 这里不要再定义 STORAGE_BUCKETS 之类"值里套 ${...}"的变量：
# Compose 只对 compose 文件做插值，不对 env 文件的值做二次插值，
# ${MINIO_USER} 会原样进容器。datalake 的 BUCKETS 已直接写在
# docker-compose.prod.yaml 里，在那儿插值才生效。

# 管理员邮箱，逗号分隔
ADMIN_EMAILS=admin

# ── 飞书（没有域名时全部留空，provider 不注册、按钮不显示）
FEISHU_CLIENT_ID=
FEISHU_CLIENT_SECRET=
FEISHU_ALLOWED_TENANT_KEYS=
FEISHU_DISPLAY_NAME=飞书
FEISHU_REDIRECT_URL=
FEISHU_TENANT_WORKSPACE_MAP=
FEISHU_AUTO_PROVISION=
FEISHU_SYNC_PROFILE=
FEISHU_STATE_HMAC_SECRET=

# ── GitHub 集成
APP_ID=
CLIENT_ID=
CLIENT_SECRET=
PRIVATE_KEY=
WEBHOOK_SECRET=
BOT_NAME=
GITHUB_APP=
GITHUB_CLIENTID=
ALLOWED_WORKSPACES=*
